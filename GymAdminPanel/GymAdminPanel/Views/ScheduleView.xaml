<UserControl x:Class="GymAdminPanel.Views.ScheduleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F6F9">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Harmonogram Zajęć"
                       FontSize="28" FontWeight="Light" Foreground="#2C3E50"/>
            <TextBlock Text="{Binding StatusText}"
                       FontSize="13" Foreground="#7F8C8D" Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="◀"
                    Command="{Binding PreviousDayCommand}"
                    Width="36" Height="36"
                    Background="#2C3E50" Foreground="White"
                    BorderThickness="0" Cursor="Hand" FontSize="14"/>

            <DatePicker Grid.Column="1"
                        SelectedDate="{Binding SelectedDate}"
                        Margin="8,0" Height="36"
                        FontSize="14" Width="160"/>

            <Button Grid.Column="2" Content="▶"
                    Command="{Binding NextDayCommand}"
                    Width="36" Height="36"
                    Background="#2C3E50" Foreground="White"
                    BorderThickness="0" Cursor="Hand" FontSize="14"/>

            <Button Grid.Column="3" Content="Dziś"
                    Command="{Binding GoToTodayCommand}"
                    Margin="8,0,0,0" Padding="12,0" Height="36"
                    Background="#7F8C8D" Foreground="White"
                    BorderThickness="0" Cursor="Hand" FontSize="13"/>

            <Button Grid.Column="5" Content="＋ Dodaj zajęcia"
                    Command="{Binding ToggleAddFormCommand}"
                    Padding="14,0" Height="36"
                    Background="#27AE60" Foreground="White"
                    FontWeight="SemiBold" BorderThickness="0"
                    Cursor="Hand" FontSize="13"/>
        </Grid>

        <Border Grid.Row="2"
                Visibility="{Binding IsAddFormVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                Background="White" BorderBrush="#DDE1E7" BorderThickness="1"
                CornerRadius="4" Margin="0,0,0,12" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Nowe zajęcia"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="#2C3E50" Margin="0,0,0,12"/>

                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*" MinWidth="120"/>
                        <ColumnDefinition Width="*" MinWidth="120"/>
                        <ColumnDefinition Width="*" MinWidth="120"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,6" Margin="0,0,8,0"
                             FontSize="13" BorderBrush="#DDE1E7"
                             Tag="Nazwa zajęć *">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <VisualBrush AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                                    <VisualBrush.Visual>
                                                        <TextBlock Text="Nazwa zajęć *" Foreground="#AAB0B8" FontSize="13" Margin="10,0,0,0"/>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <TextBox Grid.Column="1"
                             Text="{Binding NewStartTime, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,6" Margin="0,0,8,0" FontSize="13"
                             BorderBrush="#DDE1E7">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <VisualBrush AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                                    <VisualBrush.Visual>
                                                        <TextBlock Text="Start (09:00)" Foreground="#AAB0B8" FontSize="13" Margin="10,0,0,0"/>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <TextBox Grid.Column="2"
                             Text="{Binding NewEndTime, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,6" Margin="0,0,8,0" FontSize="13"
                             BorderBrush="#DDE1E7">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <VisualBrush AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                                    <VisualBrush.Visual>
                                                        <TextBlock Text="Koniec (10:00)" Foreground="#AAB0B8" FontSize="13" Margin="10,0,0,0"/>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,0,8,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="Max osób:" FontSize="13" Foreground="#5D6D7E"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding NewMaxParticipants, UpdateSourceTrigger=PropertyChanged}"
                                 Width="50" Padding="6,6" FontSize="13" BorderBrush="#DDE1E7"/>
                    </StackPanel>

                    <CheckBox Grid.Column="4"
                              IsChecked="{Binding NewPersonalTraining}"
                              Content="Trening osobisty"
                              VerticalAlignment="Center"
                              Margin="0,0,12,0" FontSize="13"/>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,6" Margin="0,0,8,0" FontSize="13"
                             BorderBrush="#DDE1E7">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <VisualBrush AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                                    <VisualBrush.Visual>
                                                        <TextBlock Text="Opis (opcjonalnie)" Foreground="#AAB0B8" FontSize="13" Margin="10,0,0,0"/>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <Button Grid.Column="1"
                            Content="✓ Zapisz"
                            Command="{Binding SaveNewClassCommand}"
                            Padding="16,6" Margin="0,0,8,0"
                            Background="#27AE60" Foreground="White"
                            BorderThickness="0" Cursor="Hand" FontSize="13"/>

                    <Button Grid.Column="2"
                            Content="✕ Anuluj"
                            Command="{Binding ToggleAddFormCommand}"
                            Padding="16,6"
                            Background="#95A5A6" Foreground="White"
                            BorderThickness="0" Cursor="Hand" FontSize="13"/>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="White"
                BorderBrush="#DDE1E7" BorderThickness="1" CornerRadius="4">
            <Grid>
                <Grid Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                      Background="#88FFFFFF" Panel.ZIndex="10">
                    <TextBlock Text="⏳ Ładowanie..."
                               FontSize="16" Foreground="#2C3E50"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <StackPanel Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="📅" FontSize="48" HorizontalAlignment="Center"/>
                    <TextBlock Text="Brak zajęć w tym dniu"
                               FontSize="16" Foreground="#95A5A6"
                               HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>

                <DataGrid ItemsSource="{Binding Classes}"
                          SelectedItem="{Binding SelectedClass}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          BorderThickness="0"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F0F0F0"
                          RowBackground="White"
                          AlternatingRowBackground="#FAFBFC"
                          SelectionMode="Single"
                          FontSize="13"
                          CanUserSortColumns="True">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F8F9FA"/>
                            <Setter Property="Foreground" Value="#5A6370"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="12,10"/>
                            <Setter Property="BorderBrush" Value="#E9ECEF"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Cursor" Value="Hand"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#EBF5FB"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F5F8FA"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="12,8" Background="{TemplateBinding Background}">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.CellStyle>

                    <DataGrid.Columns>
                        <!-- Godzina -->
                        <DataGridTextColumn Header="Godzina"
                                            Binding="{Binding TimeRange}"
                                            Width="120"/>

                        <!-- Nazwa -->
                        <DataGridTextColumn Header="Nazwa zajęć"
                                            Binding="{Binding Name}"
                                            Width="*"/>

                        <!-- Trener -->
                        <DataGridTextColumn Header="Trener"
                                            Binding="{Binding TrainerName}"
                                            Width="160"/>

                        <!-- Uczestnicy -->
                        <DataGridTemplateColumn Header="Uczestnicy" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="3" Padding="6,3" HorizontalAlignment="Left"
                                            Background="{Binding IsFull, Converter={StaticResource BoolToRedGreenConverter}}">
                                        <TextBlock Text="{Binding ParticipantsDisplay}"
                                                   Foreground="White" FontWeight="SemiBold" FontSize="11"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Typ -->
                        <DataGridTemplateColumn Header="Typ" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="3" Padding="6,3" HorizontalAlignment="Left"
                                            Background="{Binding PersonalTraining, Converter={StaticResource BoolToTypeColorConverter}}">
                                        <TextBlock Text="{Binding TypeLabel}"
                                                   Foreground="White" FontWeight="SemiBold" FontSize="11"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Lokalizacja"
                                            Binding="{Binding LocationName}"
                                            Width="140"/>

                        <DataGridTemplateColumn Header="Akcje" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="👥 Uczestnicy"
                                                Command="{Binding DataContext.ShowParticipantsCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Background="#2980B9" Foreground="White"
                                                BorderThickness="0" Padding="7,4"
                                                FontSize="11" Cursor="Hand" Margin="0,0,6,0"/>
                                        <Button Content="🗑"
                                                Command="{Binding DataContext.DeleteClassCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Background="#E74C3C" Foreground="White"
                                                BorderThickness="0" Padding="7,4"
                                                FontSize="11" Cursor="Hand"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <TextBlock Grid.Row="4"
                   Text="{Binding FooterText}"
                   FontSize="12" Foreground="#95A5A6" Margin="0,8,0,0"/>
    </Grid>
</UserControl>

<UserControl x:Class="GymAdminPanel.Views.ScheduleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:services="clr-namespace:GymAdminPanel.Services"
             Background="#0E131F"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <Style x:Key="DarkInputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Foreground" Value="#F4F7FF"/>
            <Setter Property="CaretBrush" Value="#8DA5FF"/>
            <Setter Property="Background" Value="#151B27"/>
            <Setter Property="BorderBrush" Value="#343B4D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="DarkComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Foreground" Value="#F4F7FF"/>
            <Setter Property="Background" Value="#151B27"/>
            <Setter Property="BorderBrush" Value="#343B4D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#DDE3F1"/>
                        <Setter Property="Background" Value="#151B27"/>
                        <Setter Property="Padding" Value="12,9"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemRoot"
                                            Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemRoot" Property="Background" Value="#252F45"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemRoot" Property="Background" Value="#2B3560"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ToggleRoot"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="34"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Margin="12,0,0,0"
                                                                  HorizontalAlignment="Left"
                                                                  VerticalAlignment="Center"/>
                                                <iconPacks:PackIconMaterial Grid.Column="1"
                                                                            Kind="ChevronDown"
                                                                            Width="18"
                                                                            Height="18"
                                                                            Foreground="#9EA6B8"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToggleRoot" Property="BorderBrush" Value="#566987"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              Margin="12,0,34,0"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"/>
                            <Popup Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="#151B27"
                                        BorderBrush="#3A445A"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="220">
                                    <ScrollViewer Margin="0,4"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PanelCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#171C28"/>
            <Setter Property="BorderBrush" Value="#343B4D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
        </Style>

        <Style x:Key="GhostButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="MinWidth" Value="46"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="#171C28"/>
            <Setter Property="BorderBrush" Value="#343B4D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#DDE7FF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#232B3E"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#6075B7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#111827"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="MinWidth" Value="168"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Foreground" Value="#F4F7FF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#668AFF" Offset="0"/>
                        <GradientStop Color="#5A33D6" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.78"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Margin="30,30,30,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,26">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="{Binding [Schedule.Title], Source={x:Static services:LocalizationService.Instance}}"
                           Foreground="#F4F7FF"
                           FontSize="34"
                           FontWeight="Bold"/>
                <TextBlock Text="{Binding StatusText}"
                           Foreground="#A8AFBF"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Margin="0,6,0,0"/>
            </StackPanel>

        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource PanelCardStyle}" Padding="24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Command="{Binding PreviousDayCommand}" Style="{StaticResource GhostButtonStyle}">
                        <iconPacks:PackIconMaterial Kind="ChevronLeft" Width="24" Height="24"/>
                    </Button>

                    <Border Grid.Column="1"
                            Height="44"
                            Margin="8,0"
                            Background="#151B27"
                            BorderBrush="#343B4D"
                            BorderThickness="1"
                            CornerRadius="9"
                            Padding="16,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding SelectedDate, StringFormat=dd.MM.yyyy}"
                                       Foreground="#F4F7FF"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <iconPacks:PackIconMaterial Grid.Column="1"
                                                        Kind="CalendarMonth"
                                                        Width="20"
                                                        Height="20"
                                                        Foreground="#BFD0FF"
                                                        VerticalAlignment="Center"
                                                        Margin="14,0,0,0"/>
                        </Grid>
                    </Border>

                    <Button Grid.Column="2" Command="{Binding NextDayCommand}" Style="{StaticResource GhostButtonStyle}">
                        <iconPacks:PackIconMaterial Kind="ChevronRight" Width="24" Height="24"/>
                    </Button>

                    <Button Grid.Column="3"
                            Content="{Binding [Common.Today], Source={x:Static services:LocalizationService.Instance}}"
                            Command="{Binding GoToTodayCommand}"
                            Style="{StaticResource GhostButtonStyle}"
                            Margin="18,0,0,0"/>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource PanelCardStyle}" Padding="24" Margin="0,0,0,24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding [Common.Search], Source={x:Static services:LocalizationService.Instance}}" Foreground="#C9CDDC" FontSize="15" Margin="0,0,0,10"/>
                <TextBlock Grid.Column="1" Text="{Binding [Schedule.Trainer], Source={x:Static services:LocalizationService.Instance}}" Foreground="#C9CDDC" FontSize="15" Margin="14,0,0,10"/>
                <TextBlock Grid.Column="2" Text="{Binding [Schedule.Location], Source={x:Static services:LocalizationService.Instance}}" Foreground="#C9CDDC" FontSize="15" Margin="14,0,0,10"/>
                <TextBlock Grid.Column="3" Text="{Binding [Schedule.Type], Source={x:Static services:LocalizationService.Instance}}" Foreground="#C9CDDC" FontSize="15" Margin="14,0,0,10"/>
                <TextBlock Grid.Column="4" Text="{Binding [Common.Status], Source={x:Static services:LocalizationService.Instance}}" Foreground="#C9CDDC" FontSize="15" Margin="14,0,0,10"/>

                <Border Grid.Row="1"
                        Background="#151B27"
                        BorderBrush="#343B4D"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,14,0"
                        Padding="14,0"
                        Height="46">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <iconPacks:PackIconMaterial Kind="Magnify"
                                                    Width="20"
                                                    Height="20"
                                                    Foreground="#C6CDDB"
                                                    VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Foreground="#F4F7FF"
                                 CaretBrush="#8DA5FF"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontSize="14"
                                 VerticalContentAlignment="Center">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <Grid>
                                                    <ScrollViewer x:Name="PART_ContentHost"/>
                                                    <TextBlock Text="{Binding [Schedule.SearchPlaceholder], Source={x:Static services:LocalizationService.Instance}}"
                                                               Foreground="#687185"
                                                               FontSize="14"
                                                               VerticalAlignment="Center"
                                                               IsHitTestVisible="False">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>
                </Border>
                <ComboBox Grid.Row="1" Grid.Column="1"
                          ItemsSource="{Binding TrainerFilters}"
                          SelectedItem="{Binding SelectedTrainerFilter}"
                          Style="{StaticResource DarkComboStyle}"
                          Margin="14,0,0,0"/>
                <ComboBox Grid.Row="1" Grid.Column="2"
                          ItemsSource="{Binding LocationFilters}"
                          SelectedItem="{Binding SelectedLocationFilter}"
                          Style="{StaticResource DarkComboStyle}"
                          Margin="14,0,0,0"/>
                <ComboBox Grid.Row="1" Grid.Column="3"
                          ItemsSource="{Binding TypeFilters}"
                          SelectedItem="{Binding SelectedTypeFilter}"
                          Style="{StaticResource DarkComboStyle}"
                          Margin="14,0,0,0"/>
                <ComboBox Grid.Row="1" Grid.Column="4"
                          ItemsSource="{Binding AvailabilityFilters}"
                          SelectedItem="{Binding SelectedAvailabilityFilter}"
                          Style="{StaticResource DarkComboStyle}"
                          Margin="14,0,0,0"/>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <Border Style="{StaticResource PanelCardStyle}" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="58"/>
                    </Grid.RowDefinitions>

                    <DataGrid ItemsSource="{Binding FilteredClasses}"
                              SelectedItem="{Binding SelectedClass}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              BorderThickness="0"
                              Background="#171C28"
                              RowBackground="#171C28"
                              AlternatingRowBackground="#171C28"
                              Foreground="#F4F7FF"
                              GridLinesVisibility="None"
                              HeadersVisibility="Column"
                              SelectionMode="Single"
                              CanUserSortColumns="True"
                              FontSize="14">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#202530"/>
                                <Setter Property="Foreground" Value="#C9CDDC"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="14"/>
                                <Setter Property="Padding" Value="16,16"/>
                                <Setter Property="BorderBrush" Value="#343B4D"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="MinHeight" Value="78"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1E2534"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#242D42"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#DDE3F1"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Padding="16,12" Background="{TemplateBinding Background}">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.CellStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{Binding [Schedule.TimeHeader], Source={x:Static services:LocalizationService.Instance}}" Binding="{Binding TimeRange}" Width="130"/>
                            <DataGridTextColumn Header="{Binding [Schedule.NameHeader], Source={x:Static services:LocalizationService.Instance}}" Binding="{Binding Name}" Width="1*"/>
                            <DataGridTextColumn Header="{Binding [Schedule.TrainerHeader], Source={x:Static services:LocalizationService.Instance}}" Binding="{Binding TrainerName}" Width="1.2*"/>
                            <DataGridTextColumn Header="{Binding [Schedule.LocationHeader], Source={x:Static services:LocalizationService.Instance}}" Binding="{Binding LocationName}" Width="1.2*"/>
                            <DataGridTemplateColumn Header="{Binding [Schedule.TypeHeader], Source={x:Static services:LocalizationService.Instance}}" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="12" Padding="10,4" HorizontalAlignment="Left"
                                                Background="{Binding PersonalTraining, Converter={StaticResource BoolToTypeColorConverter}}">
                                            <TextBlock Text="{Binding TypeLabel}" Foreground="White" FontWeight="Bold" FontSize="12"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{Binding [Schedule.ParticipantsHeader], Source={x:Static services:LocalizationService.Instance}}" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="12" Padding="10,4" HorizontalAlignment="Left"
                                                Background="{Binding IsFull, Converter={StaticResource BoolToRedGreenConverter}}">
                                            <TextBlock Text="{Binding ParticipantsDisplay}" Foreground="White" FontWeight="Bold" FontSize="12"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="2">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FilteredClasses.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <iconPacks:PackIconMaterial Kind="CalendarBlankOutline" Width="46" Height="46" Foreground="#626B7F" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                        <TextBlock Text="{Binding [Schedule.NoClasses], Source={x:Static services:LocalizationService.Instance}}" Foreground="#DDE3F1" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding [Schedule.NoClassesHint], Source={x:Static services:LocalizationService.Instance}}" Foreground="#A2A9BB" FontSize="14" Margin="0,8,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="1" Background="#202530" BorderBrush="#343B4D" BorderThickness="0,1,0,0" Padding="22,0">
                        <TextBlock Text="{Binding FooterText}" Foreground="#C9CDDC" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Border>

                    <Grid Grid.RowSpan="2" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" Background="#AA0E131F" Panel.ZIndex="20">
                        <Border Background="#171C28" BorderBrush="#343B4D" BorderThickness="1" CornerRadius="12" Padding="24,18" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{Binding [Schedule.Loading], Source={x:Static services:LocalizationService.Instance}}" Foreground="#DDE7FF" FontSize="15" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

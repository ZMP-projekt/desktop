<UserControl x:Class="GymAdminPanel.Views.ScheduleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F6F9">

    <UserControl.Resources>
        <Style x:Key="ScheduleComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DDE1E7"/>
        </Style>

        <Style x:Key="TableActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="34"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Harmonogram Zajęć"
                       FontSize="28" FontWeight="Light" Foreground="#2C3E50"/>
            <TextBlock Text="{Binding StatusText}"
                       FontSize="13" Foreground="#7F8C8D" Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="◀" Command="{Binding PreviousDayCommand}"
                    Width="36" Height="36" Background="#2C3E50" Foreground="White"
                    BorderThickness="0" Cursor="Hand" FontSize="14"/>
            <DatePicker Grid.Column="1" SelectedDate="{Binding SelectedDate}"
                        Margin="8,0" Height="36" Width="160" FontSize="14"/>
            <Button Grid.Column="2" Content="▶" Command="{Binding NextDayCommand}"
                    Width="36" Height="36" Background="#2C3E50" Foreground="White"
                    BorderThickness="0" Cursor="Hand" FontSize="14"/>
            <Button Grid.Column="3" Content="Dziś" Command="{Binding GoToTodayCommand}"
                    Margin="8,0,0,0" Padding="12,0" Height="36"
                    Background="#7F8C8D" Foreground="White"
                    BorderThickness="0" Cursor="Hand" FontSize="13"/>
            <Button Grid.Column="5" Content="＋ Dodaj zajęcia"
                    Command="{Binding ToggleAddFormCommand}"
                    Padding="14,0" Height="36"
                    Background="#27AE60" Foreground="White"
                    FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" FontSize="13"/>
        </Grid>

        <ItemsControl Grid.Row="2" ItemsSource="{Binding WeekDays}" Margin="0,0,0,12">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" Columns="7"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Command="{Binding DataContext.SelectDateCommand,
                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding Date}"
                            Margin="0,0,8,0"
                            Padding="8,5"
                            Height="46"
                            BorderThickness="1"
                            BorderBrush="#DDE1E7"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="#2C3E50"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Background" Value="#2980B9"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderBrush" Value="#2980B9"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#EBF5FB"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel>
                            <TextBlock Text="{Binding Header}" TextAlignment="Center" FontSize="12"/>
                            <TextBlock Text="{Binding Subheader}" TextAlignment="Center" FontSize="13"
                                       FontWeight="SemiBold" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Height="34"
                     Padding="10,7" FontSize="13" Margin="0,0,8,0"
                     Background="White" BorderBrush="#DDE1E7" BorderThickness="1"
                     VerticalContentAlignment="Center">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <VisualBrush AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                            <VisualBrush.Visual>
                                                <TextBlock Text="Szukaj po nazwie, trenerze lub lokalizacji..."
                                                           Foreground="#AAB0B8" FontSize="13" Margin="10,0,0,0"/>
                                            </VisualBrush.Visual>
                                        </VisualBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>

            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding TrainerFilters}"
                      SelectedItem="{Binding SelectedTrainerFilter}"
                      Margin="0,0,8,0"
                      Style="{StaticResource ScheduleComboStyle}"/>

            <ComboBox Grid.Column="2"
                      ItemsSource="{Binding LocationFilters}"
                      SelectedItem="{Binding SelectedLocationFilter}"
                      Margin="0,0,8,0"
                      Style="{StaticResource ScheduleComboStyle}"/>

            <ComboBox Grid.Column="3"
                      ItemsSource="{Binding TypeFilters}"
                      SelectedItem="{Binding SelectedTypeFilter}"
                      Margin="0,0,8,0"
                      Style="{StaticResource ScheduleComboStyle}"/>

            <ComboBox Grid.Column="4"
                      ItemsSource="{Binding AvailabilityFilters}"
                      SelectedItem="{Binding SelectedAvailabilityFilter}"
                      Style="{StaticResource ScheduleComboStyle}"/>
        </Grid>

        <Border Grid.Row="4"
                Visibility="{Binding IsAddFormVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                Background="White" BorderBrush="#DDE1E7" BorderThickness="1"
                CornerRadius="4" Margin="0,0,0,12" Padding="16">
            <StackPanel>
                <TextBlock Text="Nowe zajęcia" FontSize="16" FontWeight="SemiBold"
                           Foreground="#2C3E50" Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="130"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Margin="0,0,8,0"
                             Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,7" FontSize="13" BorderBrush="#DDE1E7">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <VisualBrush AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                                    <VisualBrush.Visual>
                                                        <TextBlock Text="Nazwa zajęć *" Foreground="#AAB0B8" FontSize="13" Margin="10,0,0,0"/>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <TextBox Grid.Column="1" Margin="0,0,8,0"
                             Text="{Binding NewStartTime, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,7" FontSize="13" BorderBrush="#DDE1E7">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <VisualBrush AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                                    <VisualBrush.Visual>
                                                        <TextBlock Text="Start (09:00)" Foreground="#AAB0B8" FontSize="13" Margin="10,0,0,0"/>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <TextBox Grid.Column="2" Margin="0,0,8,0"
                             Text="{Binding NewEndTime, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,7" FontSize="13" BorderBrush="#DDE1E7">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <VisualBrush AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                                    <VisualBrush.Visual>
                                                        <TextBlock Text="Koniec (10:00)" Foreground="#AAB0B8" FontSize="13" Margin="10,0,0,0"/>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Max osób:" FontSize="13" Foreground="#5D6D7E"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding NewMaxParticipants, UpdateSourceTrigger=PropertyChanged}"
                                 Width="55" Padding="8,7" FontSize="13" BorderBrush="#DDE1E7"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Lokalizacja *" FontSize="11"
                                   Foreground="#7F8C8D" Margin="0,0,0,3"/>
                        <ComboBox ItemsSource="{Binding Locations}"
                                  SelectedItem="{Binding SelectedLocation}"
                                  DisplayMemberPath="DisplayName"
                                  Padding="8,6" FontSize="13" BorderBrush="#DDE1E7"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock FontSize="11" Margin="0,0,0,3">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Trener *"/>
                                    <Setter Property="Foreground" Value="#7F8C8D"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasTrainers}" Value="False">
                                            <Setter Property="Text" Value="Trener (oczekuje na aktualizację API)"/>
                                            <Setter Property="Foreground" Value="#E67E22"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ComboBox ItemsSource="{Binding Trainers}"
                                  SelectedItem="{Binding SelectedTrainer}"
                                  DisplayMemberPath="DisplayName"
                                  IsEnabled="{Binding HasTrainers}"
                                  Padding="8,6" FontSize="13" BorderBrush="#DDE1E7"/>
                    </StackPanel>

                    <CheckBox Grid.Column="2"
                              IsChecked="{Binding NewPersonalTraining}"
                              Content="Trening osobisty"
                              VerticalAlignment="Bottom" Margin="0,0,0,5" FontSize="13"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Margin="0,0,8,0"
                             Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,7" FontSize="13" BorderBrush="#DDE1E7">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <VisualBrush AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                                    <VisualBrush.Visual>
                                                        <TextBlock Text="Opis (opcjonalnie)" Foreground="#AAB0B8" FontSize="13" Margin="10,0,0,0"/>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <Button Grid.Column="1" Content="✓ Zapisz"
                            Command="{Binding SaveNewClassCommand}"
                            Padding="16,7" Margin="0,0,8,0"
                            Background="#27AE60" Foreground="White"
                            BorderThickness="0" Cursor="Hand" FontSize="13"/>
                    <Button Grid.Column="2" Content="✕ Anuluj"
                            Command="{Binding ToggleAddFormCommand}"
                            Padding="16,7" Background="#95A5A6" Foreground="White"
                            BorderThickness="0" Cursor="Hand" FontSize="13"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="5" Background="White"
                BorderBrush="#DDE1E7" BorderThickness="1" CornerRadius="4">
            <Grid>
                <Grid Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                      Background="#88FFFFFF" Panel.ZIndex="10">
                    <TextBlock Text="⏳ Ładowanie..." FontSize="16" Foreground="#2C3E50"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Panel.ZIndex="1">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FilteredClasses.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Brak zajęć dla wybranych filtrów"
                               FontSize="16" Foreground="#2C3E50"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Zmień datę lub filtry, aby zobaczyć inne zajęcia."
                               FontSize="12" Foreground="#95A5A6"
                               HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>

                <DataGrid ItemsSource="{Binding FilteredClasses}"
                          SelectedItem="{Binding SelectedClass}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          BorderThickness="0" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F0F0F0"
                          RowBackground="White" AlternatingRowBackground="#FAFBFC"
                          SelectionMode="Single" CanUserSortColumns="True" FontSize="13">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F8F9FA"/>
                            <Setter Property="Foreground" Value="#5A6370"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="12,10"/>
                            <Setter Property="BorderBrush" Value="#E9ECEF"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Cursor" Value="Hand"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#EBF5FB"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F5F8FA"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="12,8" Background="{TemplateBinding Background}">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.CellStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Godzina" Binding="{Binding TimeRange}" Width="120"/>
                        <DataGridTextColumn Header="Nazwa zajęć" Binding="{Binding Name}" Width="1.4*"/>
                        <DataGridTextColumn Header="Trener" Binding="{Binding TrainerName}" Width="180"/>
                        <DataGridTemplateColumn Header="Uczestnicy" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="3" Padding="6,3" HorizontalAlignment="Left"
                                            Background="{Binding IsFull, Converter={StaticResource BoolToRedGreenConverter}}">
                                        <TextBlock Text="{Binding ParticipantsDisplay}"
                                                   Foreground="White" FontWeight="SemiBold" FontSize="11"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Typ" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="3" Padding="6,3" HorizontalAlignment="Left"
                                            Background="{Binding PersonalTraining, Converter={StaticResource BoolToTypeColorConverter}}">
                                        <TextBlock Text="{Binding TypeLabel}"
                                                   Foreground="White" FontWeight="SemiBold" FontSize="11"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Lokalizacja" Binding="{Binding LocationName}" Width="190"/>
                        <DataGridTemplateColumn Header="Akcje" Width="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="👥 Uczestnicy"
                                                Command="{Binding DataContext.ShowParticipantsCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Background="#2980B9"
                                                Style="{StaticResource TableActionButtonStyle}"
                                                Margin="0,0,6,0"/>
                                        <Button Content="🗑"
                                                Command="{Binding DataContext.DeleteClassCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Background="#E74C3C"
                                                Style="{StaticResource TableActionButtonStyle}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <TextBlock Grid.Row="6" Text="{Binding FooterText}"
                   FontSize="12" Foreground="#95A5A6" Margin="0,8,0,0"/>
    </Grid>
</UserControl>

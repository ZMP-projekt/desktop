<UserControl x:Class="GymAdminPanel.Views.AuditLogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F6F9">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Logi Audytowe"
                       FontSize="28" FontWeight="Light" Foreground="#2C3E50"/>
            <TextBlock Text="{Binding StatusText}"
                       FontSize="13" Foreground="#7F8C8D" Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Padding="10,8" FontSize="14" Margin="0,0,8,0"
                     Background="White" BorderBrush="#DDE1E7" BorderThickness="1"
                     VerticalContentAlignment="Center">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <VisualBrush AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                            <VisualBrush.Visual>
                                                <TextBlock Text="🔍  Szukaj po osobie, akcji lub szczegółach..."
                                                           Foreground="#AAB0B8" FontSize="14" Margin="10,0,0,0"/>
                                            </VisualBrush.Visual>
                                        </VisualBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>

            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding ActionFilters}"
                      SelectedItem="{Binding SelectedActionFilter}"
                      Padding="10,8" FontSize="13" Margin="0,0,8,0"
                      Background="White" BorderBrush="#DDE1E7"/>

            <Button Grid.Column="2"
                    Content="🔄 Odśwież"
                    Command="{Binding LoadLogsCommand}"
                    Padding="14,8"
                    Background="#2980B9" Foreground="White"
                    FontWeight="SemiBold" BorderThickness="0"
                    Cursor="Hand" FontSize="13"/>
        </Grid>

        <Border Grid.Row="2" Background="White"
                BorderBrush="#DDE1E7" BorderThickness="1" CornerRadius="4">
            <Grid>
                <Grid Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                      Background="#88FFFFFF" Panel.ZIndex="10">
                    <TextBlock Text="⏳ Ładowanie logów..."
                               FontSize="16" Foreground="#2C3E50"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <DataGrid ItemsSource="{Binding FilteredLogs}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          BorderThickness="0"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F0F0F0"
                          RowBackground="White"
                          AlternatingRowBackground="#FAFBFC"
                          SelectionMode="Single"
                          CanUserSortColumns="True"
                          FontSize="13">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F8F9FA"/>
                            <Setter Property="Foreground" Value="#5A6370"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="12,10"/>
                            <Setter Property="BorderBrush" Value="#E9ECEF"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#EBF5FB"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F5F8FA"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="12,8" Background="{TemplateBinding Background}">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.CellStyle>

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Data i godzina"
                                            Binding="{Binding TimestampDisplay}"
                                            Width="160"
                                            CanUserSort="True"
                                            SortMemberPath="Timestamp"/>

                        <DataGridTextColumn Header="Wykonał"
                                            Binding="{Binding ChangedBy}"
                                            Width="180"/>

                        <DataGridTemplateColumn Header="Akcja" Width="180" SortMemberPath="Action">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="3" Padding="7,3" HorizontalAlignment="Left"
                                            Background="{Binding Action, Converter={StaticResource ActionToColorConverter}}">
                                        <TextBlock Text="{Binding Action}"
                                                   Foreground="White"
                                                   FontWeight="SemiBold"
                                                   FontSize="11"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Szczegóły"
                                            Binding="{Binding Details}"
                                            Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3"
                   Text="{Binding FooterText}"
                   FontSize="12" Foreground="#95A5A6" Margin="0,8,0,0"/>
    </Grid>
</UserControl>

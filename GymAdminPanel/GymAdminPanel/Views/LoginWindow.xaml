<Window x:Class="GymAdminPanel.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Logowanie"
        Icon="/Assets/logo.png"
        Height="700"
        Width="620"
        MinHeight="640"
        MinWidth="560"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#0A0E1A"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D7DCEF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="4,0,0,8"/>
        </Style>

        <Style x:Key="LoginTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="54"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F3F6FF"/>
            <Setter Property="CaretBrush" Value="#7EA2FF"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="LoginPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="54"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F3F6FF"/>
            <Setter Property="CaretBrush" Value="#7EA2FF"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="InputShellStyle" TargetType="Border">
            <Setter Property="Height" Value="56"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="#090E19"/>
            <Setter Property="BorderBrush" Value="#4A5267"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid ClipToBounds="True">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#182643" Offset="0"/>
                <GradientStop Color="#0B1020" Offset="0.42"/>
                <GradientStop Color="#1D1034" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Border Height="1"
                VerticalAlignment="Top"
                Background="#273047"
                Opacity="0.75"/>

        <Ellipse Width="860"
                 Height="860"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 Margin="-280,-360,0,0"
                 Opacity="0.38">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#3E86FF" Offset="0"/>
                    <GradientStop Color="#14264C" Offset="0.48"/>
                    <GradientStop Color="#0B1020" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Effect>
                <BlurEffect Radius="42"/>
            </Ellipse.Effect>
        </Ellipse>

        <Ellipse Width="760"
                 Height="760"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Bottom"
                 Margin="0,0,-260,-300"
                 Opacity="0.44">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#6C3CFF" Offset="0"/>
                    <GradientStop Color="#241242" Offset="0.52"/>
                    <GradientStop Color="#0B1020" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Effect>
                <BlurEffect Radius="46"/>
            </Ellipse.Effect>
        </Ellipse>

        <Grid Margin="36,86,36,46">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="1"
                    Width="430"
                    HorizontalAlignment="Center"
                    Padding="44,36"
                    CornerRadius="12"
                    Background="#171C28"
                    BorderBrush="#353C50"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#030711"
                                      BlurRadius="44"
                                      ShadowDepth="18"
                                      Opacity="0.45"/>
                </Border.Effect>

                <StackPanel>
                    <StackPanel HorizontalAlignment="Center"
                                Margin="0,0,0,36">
                        <Border Width="76"
                                Height="76"
                                CornerRadius="20"
                                Margin="0,0,0,24">
                            <Border.Effect>
                                <DropShadowEffect Color="#637EFF"
                                                  BlurRadius="30"
                                                  ShadowDepth="0"
                                                  Opacity="0.35"/>
                            </Border.Effect>
                            <Image Source="/Assets/logo.png"
                                   Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>

                        <TextBlock Text="Gym Admin"
                                   Foreground="#F4F7FF"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   TextAlignment="Center"/>
                        <TextBlock Text="Panel administratora"
                                   Foreground="#A7AEC0"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   Margin="0,8,0,0"/>
                    </StackPanel>

                    <TextBlock Text="Email" Style="{StaticResource FieldLabelStyle}"/>
                    <Border Style="{StaticResource InputShellStyle}" Margin="0,0,0,22">
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource LoginTextBoxStyle}"/>
                    </Border>

                    <TextBlock Text="Hasło" Style="{StaticResource FieldLabelStyle}"/>
                    <Border Style="{StaticResource InputShellStyle}"
                            BorderBrush="#5A6380"
                            Margin="0,0,0,30">
                        <PasswordBox x:Name="PasswordInput"
                                     PasswordChanged="PasswordInput_PasswordChanged"
                                     KeyDown="PasswordInput_KeyDown"
                                     Style="{StaticResource LoginPasswordBoxStyle}"/>
                    </Border>

                    <Button Command="{Binding LoginCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                            Height="58"
                            Cursor="Hand"
                            IsEnabled="{Binding IsLoginEnabled}"
                            BorderThickness="0"
                            Foreground="#101525"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Content="{Binding LoginButtonText}"
                            Margin="0,0,0,20">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#6085FF" Offset="0"/>
                                <GradientStop Color="#6234D4" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <Button.Effect>
                            <DropShadowEffect Color="#5B63FF"
                                              BlurRadius="26"
                                              ShadowDepth="0"
                                              Opacity="0.32"/>
                        </Button.Effect>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="0.94"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Opacity" Value="0.82"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.48"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#FF8795"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               MinHeight="24"/>

                    <Border Height="1"
                            Background="#2A3040"
                            Opacity="0.8"
                            Margin="0,20,0,24"/>

                    <TextBlock Text="Dostęp tylko dla administratorów"
                               Foreground="#8F96A9"
                               FontSize="12"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>

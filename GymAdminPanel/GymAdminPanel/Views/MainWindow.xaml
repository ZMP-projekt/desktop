<Window x:Class="GymAdminPanel.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="{Binding Title}"
        Height="760"
        Width="1180"
        MinHeight="680"
        MinWidth="1040"
        Icon="/Assets/logo.png"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#0B101B"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#C9CDDC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Margin" Value="14,0,14,8"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#202636"/>
                                <Setter Property="Foreground" Value="#F4F7FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavIconStyle" TargetType="iconPacks:PackIconMaterial">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="NavLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TopbarActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="MinWidth" Value="136"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#F4F7FF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#668AFF" Offset="0"/>
                        <GradientStop Color="#5A33D6" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.78"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#151A25"
                BorderBrush="#242B3A"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="22,24,18,34">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="54"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Image Source="/Assets/logo.png"
                           Width="44"
                           Height="44"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Gym Admin"
                                   Foreground="#F4F7FF"
                                   FontSize="22"
                                   FontWeight="Bold"/>
                        <TextBlock Text="PANEL ADMINISTRATORA"
                                   Foreground="#8E95A8"
                                   FontSize="10"
                                   FontWeight="Bold"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1" Margin="0,24,0,0">
                    <Button Command="{Binding ShowDashboardCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveSection}" Value="dashboard">
                                        <Setter Property="Background" Value="#202636"/>
                                        <Setter Property="Foreground" Value="#DDE7FF"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="ViewDashboard" Style="{StaticResource NavIconStyle}"/>
                            <TextBlock Text="Dashboard" Style="{StaticResource NavLabelStyle}"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ShowUsersCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveSection}" Value="users">
                                        <Setter Property="Background" Value="#202636"/>
                                        <Setter Property="Foreground" Value="#DDE7FF"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="AccountGroup" Style="{StaticResource NavIconStyle}"/>
                            <TextBlock Text="Użytkownicy" Style="{StaticResource NavLabelStyle}"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ShowScheduleCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveSection}" Value="schedule">
                                        <Setter Property="Background" Value="#202636"/>
                                        <Setter Property="Foreground" Value="#DDE7FF"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="CalendarMonth" Style="{StaticResource NavIconStyle}"/>
                            <TextBlock Text="Harmonogram" Style="{StaticResource NavLabelStyle}"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ShowTrainersCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveSection}" Value="trainers">
                                        <Setter Property="Background" Value="#202636"/>
                                        <Setter Property="Foreground" Value="#DDE7FF"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="WeightLifter" Style="{StaticResource NavIconStyle}"/>
                            <TextBlock Text="Trenerzy" Style="{StaticResource NavLabelStyle}"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ShowAuditLogsCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveSection}" Value="auditlogs">
                                        <Setter Property="Background" Value="#202636"/>
                                        <Setter Property="Foreground" Value="#DDE7FF"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="ClipboardTextClockOutline" Style="{StaticResource NavIconStyle}"/>
                            <TextBlock Text="Logi audytowe" Style="{StaticResource NavLabelStyle}"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ShowNotificationsCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveSection}" Value="notifications">
                                        <Setter Property="Background" Value="#202636"/>
                                        <Setter Property="Foreground" Value="#DDE7FF"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="BellOutline" Style="{StaticResource NavIconStyle}"/>
                            <TextBlock Text="Powiadomienia" Style="{StaticResource NavLabelStyle}"/>
                            <Border Margin="10,0,0,0"
                                    Padding="6,1"
                                    CornerRadius="8"
                                    Background="#E95A72"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding UnreadNotificationsCount,
                                        Converter={StaticResource IntToVisibilityConverter}}">
                                <TextBlock Text="{Binding UnreadNotificationsCount}"
                                           Foreground="White"
                                           FontSize="10"
                                           FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border Grid.Row="2"
                        BorderBrush="#2A3141"
                        BorderThickness="0,1,0,0"
                        Padding="14,18"
                        Margin="14,0,14,18">
                    <Button Command="{Binding LogoutCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                            Height="44"
                            Cursor="Hand"
                            BorderThickness="1"
                            BorderBrush="#363F54"
                            Background="#1B2230"
                            Foreground="#F3F6FF"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Content="Wyloguj">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Root"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Root" Property="Background" Value="#252D3F"/>
                                        <Setter TargetName="Root" Property="BorderBrush" Value="#5B6B91"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Root" Property="Background" Value="#151B27"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="#0E131F">
            <Grid.RowDefinitions>
                <RowDefinition Height="72"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#0B101B"
                    BorderBrush="#1C2331"
                    BorderThickness="0,0,0,1">
                <Grid Margin="28,0">
                    <Button Command="{Binding RefreshCurrentSectionCommand}"
                            Style="{StaticResource TopbarActionButtonStyle}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Refresh"
                                                        Width="18"
                                                        Height="18"
                                                        Margin="0,0,10,0"
                                                        VerticalAlignment="Center"/>
                            <TextBlock Text="Odśwież"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <ContentControl Content="{Binding CurrentView}"/>

                <Border Margin="24,18,24,0"
                        Padding="14,12"
                        CornerRadius="8"
                        Background="{Binding StatusKind, Converter={StaticResource StatusKindToBrushConverter}}"
                        BorderBrush="{Binding StatusKind, Converter={StaticResource StatusKindToBrushConverter}, ConverterParameter=Border}"
                        BorderThickness="4,0,0,0"
                        VerticalAlignment="Top"
                        Panel.ZIndex="20"
                        Visibility="{Binding IsStatusVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding StatusMessage}"
                                   Foreground="{Binding StatusKind, Converter={StaticResource StatusKindToBrushConverter}, ConverterParameter=Text}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>

                        <Button Grid.Column="1"
                                Content="x"
                                Command="{Binding DismissStatusCommand}"
                                Margin="8,0,0,0"
                                Width="28"
                                Height="28"
                                Cursor="Hand"
                                BorderThickness="0"
                                Background="Transparent"
                                Foreground="{Binding StatusKind, Converter={StaticResource StatusKindToBrushConverter}, ConverterParameter=Text}"
                                FontSize="18"
                                FontWeight="SemiBold"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>

<UserControl x:Class="GymAdminPanel.Views.TrainersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="#0E131F"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <Style x:Key="DarkScrollBarThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#4B556B"
                                CornerRadius="4"
                                Margin="3"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Background" Value="#151B27"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Opacity="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource DarkScrollBarThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PanelCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#171C28"/>
            <Setter Property="BorderBrush" Value="#343B4D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="MinWidth" Value="132"/>
            <Setter Property="Foreground" Value="#F4F7FF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#668AFF" Offset="0"/>
                        <GradientStop Color="#5A33D6" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.78"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="#151B27"/>
            <Setter Property="BorderBrush" Value="#343B4D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#DDE7FF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#20283A"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#6075B7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#101622"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Foreground" Value="#F4F7FF"/>
            <Setter Property="CaretBrush" Value="#8DA5FF"/>
            <Setter Property="Background" Value="#151B27"/>
            <Setter Property="BorderBrush" Value="#343B4D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="30,30,30,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,26">
            <StackPanel>
                <TextBlock Text="Trenerzy"
                           Foreground="#F4F7FF"
                           FontSize="34"
                           FontWeight="Bold"/>
                <TextBlock Text="{Binding StatusText}"
                           Foreground="#A8AFBF"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Margin="0,6,0,0"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Style="{StaticResource PanelCardStyle}"
                Padding="18,14"
                Margin="0,0,0,22"
                MaxWidth="760"
                HorizontalAlignment="Left">
            <Grid Width="720">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <iconPacks:PackIconMaterial Kind="Magnify"
                                            Width="22"
                                            Height="22"
                                            Foreground="#C6CDDB"
                                            VerticalAlignment="Center"/>
                <TextBox Grid.Column="1"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Foreground="#F4F7FF"
                         CaretBrush="#8DA5FF"
                         Background="Transparent"
                         BorderThickness="0"
                         FontSize="16"
                         VerticalContentAlignment="Center">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TextBox">
                                        <Grid>
                                            <ScrollViewer x:Name="PART_ContentHost"/>
                                            <TextBlock Text="Szukaj po imieniu, nazwisku lub specjalizacji..."
                                                       Foreground="#687185"
                                                       FontSize="16"
                                                       VerticalAlignment="Center"
                                                       IsHitTestVisible="False">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Border Style="{StaticResource PanelCardStyle}">
                <Grid>
                    <Grid Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                          Background="#AA0E131F"
                          Panel.ZIndex="10">
                        <Border Background="#171C28"
                                BorderBrush="#343B4D"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="24,18"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <TextBlock Text="Ładowanie trenerów..."
                                       Foreground="#DDE7FF"
                                       FontSize="15"
                                       FontWeight="SemiBold"/>
                        </Border>
                    </Grid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Padding="18">
                        <ItemsControl ItemsSource="{Binding FilteredTrainers}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="260"
                                            MinHeight="360"
                                            Margin="8"
                                            Padding="22"
                                            Background="#171C28"
                                            BorderBrush="#343B4D"
                                            BorderThickness="1"
                                            CornerRadius="12">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#171C28"/>
                                                <Setter Property="BorderBrush" Value="#343B4D"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="BorderBrush" Value="#7083C7"/>
                                                        <Setter Property="Background" Value="#1B2130"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <Border Grid.Row="0"
                                                    Width="82"
                                                    Height="82"
                                                    CornerRadius="41"
                                                    Background="#252B3E"
                                                    BorderBrush="#343B4D"
                                                    BorderThickness="1"
                                                    HorizontalAlignment="Center"
                                                    Margin="0,8,0,18">
                                                <TextBlock HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="#DDE7FF"
                                                           FontSize="28"
                                                           FontWeight="Bold"
                                                           Text="{Binding Initials}"/>
                                            </Border>

                                            <TextBlock Grid.Row="1"
                                                       HorizontalAlignment="Center"
                                                       Foreground="#F4F7FF"
                                                       FontSize="23"
                                                       FontWeight="Bold"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       LineHeight="28"
                                                       Margin="0,0,0,10"
                                                       Text="{Binding NameOrEmail}"/>

                                            <Border Grid.Row="2"
                                                    CornerRadius="13"
                                                    Padding="11,4"
                                                    Background="#252D46"
                                                    BorderBrush="#475577"
                                                    BorderThickness="1"
                                                    HorizontalAlignment="Center"
                                                    Margin="0,0,0,18">
                                                <TextBlock Text="{Binding Specialization}"
                                                           Foreground="#C8D4FF"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           TextAlignment="Center"/>
                                            </Border>

                                            <TextBlock Grid.Row="3"
                                                       Text="{Binding Bio}"
                                                       Foreground="#C9CDDC"
                                                       FontSize="14"
                                                       TextWrapping="Wrap"
                                                       TextAlignment="Center"
                                                       LineHeight="22"
                                                       MaxHeight="112"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Top"
                                                       Margin="2,0,2,0"/>

                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

        </Grid>

        <TextBlock Grid.Row="3"
                   Text="{Binding FooterText}"
                   Foreground="#C9CDDC"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Margin="0,18,0,0"/>
    </Grid>
</UserControl>

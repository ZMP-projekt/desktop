<Window x:Class="GymAdminPanel.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="{Binding DialogTitle}"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI">

    <Border Background="#171C28"
            BorderBrush="#3A4358"
            BorderThickness="1"
            CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect Color="#020611"
                              BlurRadius="28"
                              ShadowDepth="12"
                              Opacity="0.45"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Background="#1D2432"
                  Height="54"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.Clip>
                    <RectangleGeometry Rect="0,0,440,54" RadiusX="14" RadiusY="14"/>
                </Grid.Clip>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding DialogTitle}"
                           Foreground="#F4F7FF"
                           FontSize="15"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="20,0"/>

                <Button Grid.Column="1"
                        Width="38"
                        Height="38"
                        Margin="0,0,10,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="Cancel_Click">
                    <iconPacks:PackIconMaterial Kind="Close"
                                                Width="18"
                                                Height="18"
                                                Foreground="#8790A3"/>
                </Button>
            </Grid>

            <Grid Grid.Row="1" Margin="24,24,24,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Width="46"
                        Height="46"
                        CornerRadius="12"
                        Background="{Binding AccentBackground}"
                        VerticalAlignment="Top">
                    <iconPacks:PackIconMaterial Kind="{Binding IconKind}"
                                                Width="24"
                                                Height="24"
                                                Foreground="{Binding AccentBrush}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Message}"
                               Foreground="#F4F7FF"
                               FontSize="15"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Details}"
                               Foreground="#C6CDDB"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="2"
                    Background="#202530"
                    BorderBrush="#343B4D"
                    BorderThickness="0,1,0,0"
                    Padding="20,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Nie"
                            Width="96"
                            Height="38"
                            Margin="0,0,10,0"
                            Cursor="Hand"
                            Click="Cancel_Click"
                            Background="#1A2130"
                            BorderBrush="#3B465C"
                            BorderThickness="1"
                            Foreground="#DDE7FF"
                            FontWeight="SemiBold"/>
                    <Button Content="Tak"
                            Width="96"
                            Height="38"
                            Cursor="Hand"
                            Click="Confirm_Click"
                            BorderThickness="0"
                            Foreground="#F4F7FF"
                            FontWeight="SemiBold">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#668AFF" Offset="0"/>
                                <GradientStop Color="#5A33D6" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>

<UserControl x:Class="GymAdminPanel.Views.NotificationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="#0E131F"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <Style x:Key="PrimaryActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="MinWidth" Value="210"/>
            <Setter Property="Background" Value="#171C28"/>
            <Setter Property="BorderBrush" Value="#343B4D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#DDE7FF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#20283A"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#7083C7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#121826"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="#151B27"/>
            <Setter Property="BorderBrush" Value="#2D3548"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#C9CDDC"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#20283A"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#566987"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#101622"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#C9CDDC"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinWidth" Value="112"/>
            <Setter Property="Margin" Value="0,0,34,0"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="SelectionLine"
                                    Height="3"
                                    CornerRadius="2"
                                    Background="Transparent"
                                    VerticalAlignment="Bottom"/>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#F4F7FF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#C8D4FF"/>
                                <Setter TargetName="SelectionLine" Property="Background" Value="#9DB2FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="30,30,30,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,26">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Powiadomienia"
                           Foreground="#F4F7FF"
                           FontSize="34"
                           FontWeight="Bold"/>
                <TextBlock Text="{Binding StatusText}"
                           Foreground="#A8AFBF"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Top">
                <Button Command="{Binding MarkAllReadCommand}"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="CheckAll"
                                                    Width="20"
                                                    Height="20"
                                                    Foreground="#BFD0FF"
                                                    Margin="0,0,10,0"/>
                        <TextBlock Text="Oznacz jako przeczytane"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding DeleteAllReadCommand}"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="Usuń przeczytane"
                        Margin="0,0,8,0">
                    <iconPacks:PackIconMaterial Kind="TrashCanOutline"
                                                Width="19"
                                                Height="19"
                                                Foreground="#FF8EA0"/>
                </Button>

                <Button Command="{Binding LoadNotificationsCommand}"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="Odśwież">
                    <iconPacks:PackIconMaterial Kind="Refresh"
                                                Width="19"
                                                Height="19"
                                                Foreground="#BFD0FF"/>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                BorderBrush="#252C3B"
                BorderThickness="0,0,0,1"
                Margin="0,0,0,28">
            <ListBox ItemsSource="{Binding FilterOptions}"
                     SelectedItem="{Binding SelectedFilter}"
                     ItemContainerStyle="{StaticResource FilterItemStyle}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </Border>

        <Border Grid.Row="2"
                Background="#171C28"
                BorderBrush="#343B4D"
                BorderThickness="1"
                CornerRadius="12"
                ClipToBounds="True">
            <Grid>
                <Grid Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                      Background="#AA0E131F"
                      Panel.ZIndex="10">
                    <Border Background="#171C28"
                            BorderBrush="#343B4D"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="24,18"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <TextBlock Text="Ładowanie powiadomień..."
                                   Foreground="#DDE7FF"
                                   FontSize="15"
                                   FontWeight="SemiBold"/>
                    </Border>
                </Grid>

                <StackPanel Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="320">
                    <Border Width="74"
                            Height="74"
                            CornerRadius="37"
                            Background="#202636"
                            BorderBrush="#343B4D"
                            BorderThickness="1"
                            Margin="0,0,0,18">
                        <iconPacks:PackIconMaterial Kind="BellOutline"
                                                    Width="32"
                                                    Height="32"
                                                    Foreground="#7F8AA3"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Brak powiadomień"
                               Foreground="#DDE3F1"
                               FontSize="18"
                               FontWeight="SemiBold"
                               TextAlignment="Center"/>
                    <TextBlock Text="{Binding StatusText}"
                               Foreground="#9EA6B8"
                               FontSize="14"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,8,0,0"/>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding FilteredNotifications}">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#2A3141"
                                    BorderThickness="0,0,0,1"
                                    Padding="30,24">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#121722"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Read}" Value="False">
                                                <Setter Property="Background" Value="#1C212D"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="78"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Width="46"
                                            Height="46"
                                            CornerRadius="23"
                                            Background="#252B3E"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top">
                                        <iconPacks:PackIconMaterial Kind="BellOutline"
                                                                    Width="22"
                                                                    Height="22"
                                                                    Foreground="#BFD0FF"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,0,0,6">
                                            <TextBlock Text="{Binding StatusLabel}"
                                                       Foreground="#F4F7FF"
                                                       FontSize="15"
                                                       FontWeight="Bold"/>
                                            <Ellipse Width="8"
                                                     Height="8"
                                                     Fill="#AFC0FF"
                                                     Margin="8,7,0,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Read}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                        </StackPanel>

                                        <TextBlock Text="{Binding Content}"
                                                   Foreground="#DDE3F1"
                                                   FontSize="17"
                                                   TextWrapping="Wrap"
                                                   LineHeight="24"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="24,0,0,0">
                                        <TextBlock Text="{Binding CreatedAtDisplay}"
                                                   Foreground="#A8AFBF"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,16,0"/>

                                        <Button ToolTip="Oznacz jako przeczytane"
                                                Command="{Binding DataContext.MarkReadCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Read}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <iconPacks:PackIconMaterial Kind="Check"
                                                                        Width="18"
                                                                        Height="18"
                                                                        Foreground="#BFD0FF"/>
                                        </Button>

                                        <Button ToolTip="Usuń powiadomienie"
                                                Command="{Binding DataContext.DeleteNotificationCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource IconButtonStyle}"
                                                Margin="8,0,0,0">
                                            <iconPacks:PackIconMaterial Kind="TrashCanOutline"
                                                                        Width="18"
                                                                        Height="18"
                                                                        Foreground="#FF8EA0"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3"
                   Text="{Binding FooterText}"
                   Foreground="#C9CDDC"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Margin="0,18,0,0"/>
    </Grid>
</UserControl>

<UserControl x:Class="GymAdminPanel.Views.NotificationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F6F9">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Powiadomienia"
                               FontSize="28" FontWeight="Light" Foreground="#2C3E50"/>
                    <Border Margin="10,6,0,0" Padding="7,2" CornerRadius="10"
                            Background="#E74C3C"
                            Visibility="{Binding UnreadCount, Converter={StaticResource IntToVisibilityConverter}}">
                        <TextBlock Text="{Binding UnreadCount}"
                                   Foreground="White" FontSize="12" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding StatusText}"
                           FontSize="13" Foreground="#7F8C8D" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ComboBox Grid.Column="0"
                      ItemsSource="{Binding FilterOptions}"
                      SelectedItem="{Binding SelectedFilter}"
                      Padding="10,8" FontSize="13" Width="160"
                      Margin="0,0,8,0"
                      Background="White" BorderBrush="#DDE1E7"/>

            <Border Grid.Column="1"/>

            <Button Grid.Column="2"
                    Content="✓ Oznacz wszystkie"
                    Command="{Binding MarkAllReadCommand}"
                    Padding="12,8" Margin="0,0,8,0"
                    Background="#27AE60" Foreground="White"
                    BorderThickness="0" Cursor="Hand" FontSize="13"/>

            <Button Grid.Column="3"
                    Content="🗑 Usuń przeczytane"
                    Command="{Binding DeleteAllReadCommand}"
                    Padding="12,8" Margin="0,0,8,0"
                    Background="#E74C3C" Foreground="White"
                    BorderThickness="0" Cursor="Hand" FontSize="13"/>

            <Button Grid.Column="4"
                    Content="🔄 Odśwież"
                    Command="{Binding LoadNotificationsCommand}"
                    Padding="12,8"
                    Background="#2980B9" Foreground="White"
                    BorderThickness="0" Cursor="Hand" FontSize="13"/>
        </Grid>

        <Border Grid.Row="2" Background="White"
                BorderBrush="#DDE1E7" BorderThickness="1" CornerRadius="4">
            <Grid>
                <Grid Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                      Background="#88FFFFFF" Panel.ZIndex="10">
                    <TextBlock Text="⏳ Ładowanie..."
                               FontSize="16" Foreground="#2C3E50"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <StackPanel Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="🔔" FontSize="48" HorizontalAlignment="Center"/>
                    <TextBlock Text="Brak powiadomień"
                               FontSize="16" Foreground="#95A5A6"
                               HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding FilteredNotifications}">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,1" Padding="16,12">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="White"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Read}" Value="False">
                                                <Setter Property="Background" Value="#EBF5FB"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Ellipse Grid.Column="0"
                                             Width="10" Height="10"
                                             Margin="0,0,14,0"
                                             VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Read}" Value="False">
                                                        <Setter Property="Fill" Value="#2980B9"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Content}"
                                                   FontSize="13" TextWrapping="Wrap"
                                                   Foreground="#2C3E50">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Read}" Value="False">
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding CreatedAtDisplay}"
                                                   FontSize="11" Foreground="#95A5A6"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>

                                    <Border Grid.Column="2" CornerRadius="3"
                                            Padding="7,3" Margin="12,0,0,0"
                                            VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#27AE60"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Read}" Value="False">
                                                        <Setter Property="Background" Value="#2980B9"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StatusLabel}"
                                                   Foreground="White"
                                                   FontSize="11" FontWeight="SemiBold"/>
                                    </Border>

                                    <Button Grid.Column="3"
                                            Content="✓"
                                            ToolTip="Oznacz jako przeczytane"
                                            Command="{Binding DataContext.MarkReadCommand,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Margin="8,0,0,0" Width="30" Height="30"
                                            Background="#27AE60" Foreground="White"
                                            BorderThickness="0" Cursor="Hand" FontSize="14">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Read}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <Border Grid.Column="3" Width="30" Margin="8,0,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Read}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>

                                    <Button Grid.Column="4"
                                            Content="🗑"
                                            ToolTip="Usuń powiadomienie"
                                            Command="{Binding DataContext.DeleteNotificationCommand,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Margin="6,0,0,0" Width="30" Height="30"
                                            Background="#E74C3C" Foreground="White"
                                            BorderThickness="0" Cursor="Hand" FontSize="12"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3"
                   Text="{Binding FooterText}"
                   FontSize="12" Foreground="#95A5A6" Margin="0,8,0,0"/>
    </Grid>
</UserControl>

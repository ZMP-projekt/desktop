<UserControl x:Class="GymAdminPanel.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="#0E131F"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <Style x:Key="PanelCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#171C28"/>
            <Setter Property="BorderBrush" Value="#343B4D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
        </Style>

        <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D9DEEA"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F4F7FF"/>
            <Setter Property="FontSize" Value="34"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>

        <Style x:Key="IconTileStyle" TargetType="Border">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="#2A3042"/>
        </Style>

        <Style x:Key="MetricIconStyle" TargetType="iconPacks:PackIconMaterial">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Foreground" Value="#C8D4FF"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30,30,30,24">
                <Grid Margin="0,0,0,26">
                    <StackPanel>
                        <TextBlock Text="Dashboard"
                                   Foreground="#F4F7FF"
                                   FontSize="34"
                                   FontWeight="Bold"/>
                        <TextBlock Text="{Binding StatusText}"
                                   Foreground="#A8AFBF"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>

                <UniformGrid Columns="4" Margin="0,0,0,24">
                    <Border Style="{StaticResource PanelCardStyle}" Padding="24" Margin="0,0,12,0">
                        <StackPanel>
                            <Border Style="{StaticResource IconTileStyle}">
                                <iconPacks:PackIconMaterial Kind="AccountGroup" Style="{StaticResource MetricIconStyle}"/>
                            </Border>
                            <TextBlock Text="Użytkownicy" Style="{StaticResource MetricLabelStyle}" Margin="0,20,0,0"/>
                            <TextBlock Text="{Binding UsersCount}" Style="{StaticResource MetricValueStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelCardStyle}" Padding="24" Margin="12,0,12,0">
                        <StackPanel>
                            <Border Style="{StaticResource IconTileStyle}" Background="#2C2942">
                                <iconPacks:PackIconMaterial Kind="CalendarCheck" Foreground="#BBA8FF" Style="{StaticResource MetricIconStyle}"/>
                            </Border>
                            <TextBlock Text="Dzisiejsze zajęcia" Style="{StaticResource MetricLabelStyle}" Margin="0,20,0,0"/>
                            <TextBlock Text="{Binding TodayClassesCount}" Style="{StaticResource MetricValueStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelCardStyle}" Padding="24" Margin="12,0,12,0">
                        <StackPanel>
                            <Border Style="{StaticResource IconTileStyle}" Background="#352833">
                                <iconPacks:PackIconMaterial Kind="EmailOutline" Foreground="#FFAEA7" Style="{StaticResource MetricIconStyle}"/>
                            </Border>
                            <TextBlock Text="Nieprzeczytane" Style="{StaticResource MetricLabelStyle}" Margin="0,20,0,0"/>
                            <TextBlock Text="{Binding UnreadNotificationsCount}" Style="{StaticResource MetricValueStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelCardStyle}" Padding="24" Margin="12,0,0,0">
                        <StackPanel>
                            <Border Style="{StaticResource IconTileStyle}">
                                <iconPacks:PackIconMaterial Kind="ClipboardTextClockOutline" Style="{StaticResource MetricIconStyle}"/>
                            </Border>
                            <TextBlock Text="Wpisy audytu" Style="{StaticResource MetricLabelStyle}" Margin="0,20,0,0"/>
                            <TextBlock Text="{Binding AuditLogsCount}" Style="{StaticResource MetricValueStyle}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.85*"/>
                        <ColumnDefinition Width="1.15*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Style="{StaticResource PanelCardStyle}"
                            Margin="0,0,14,0"
                            MinHeight="430">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    BorderBrush="#282F3F"
                                    BorderThickness="0,0,0,1"
                                    Padding="24,22">
                                <TextBlock Text="Dzisiejszy harmonogram"
                                           Foreground="#F4F7FF"
                                           FontSize="22"
                                           FontWeight="SemiBold"/>
                            </Border>

                            <Grid Grid.Row="1" Margin="24">
                                <ItemsControl ItemsSource="{Binding TodayClasses}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#282F3F"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="0,14">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="82"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding TimeRange}"
                                                               Foreground="#AFC0FF"
                                                               FontWeight="Bold"
                                                               VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Name}"
                                                                   Foreground="#F3F6FF"
                                                                   FontSize="14"
                                                                   FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding TrainerName}"
                                                                   Foreground="#9EA6B8"
                                                                   FontSize="12"
                                                                   Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding ParticipantsDisplay}"
                                                               Foreground="#9EA6B8"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            MaxWidth="280">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasTodayClasses}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Border Width="72"
                                            Height="72"
                                            CornerRadius="36"
                                            BorderBrush="#2D3445"
                                            BorderThickness="1"
                                            Background="#1B202C"
                                            Margin="0,0,0,24">
                                        <iconPacks:PackIconMaterial Kind="CalendarBlankOutline"
                                                                    Width="30"
                                                                    Height="30"
                                                                    Foreground="#626B7F"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Brak zaplanowanych zajęć"
                                               Foreground="#D2D7E5"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               TextAlignment="Center"/>
                                    <TextBlock Text="Na dzisiaj nie ma przypisanych treningów grupowych ani sesji indywidualnych."
                                               Foreground="#A2A9BB"
                                               FontSize="14"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               Margin="0,12,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1"
                            Style="{StaticResource PanelCardStyle}"
                            Margin="14,0,0,0"
                            MinHeight="430">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    BorderBrush="#282F3F"
                                    BorderThickness="0,0,0,1"
                                    Padding="24,22">
                                <TextBlock Text="Ostatnie akcje"
                                           Foreground="#F4F7FF"
                                           FontSize="22"
                                           FontWeight="SemiBold"/>
                            </Border>

                            <Grid Grid.Row="1">
                                <ItemsControl ItemsSource="{Binding RecentAuditLogs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#282F3F"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="24,16">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="54"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Width="40"
                                                            Height="40"
                                                            CornerRadius="10"
                                                            Background="#252C3E">
                                                        <iconPacks:PackIconMaterial Kind="Plus"
                                                                                    Width="20"
                                                                                    Height="20"
                                                                                    Foreground="#BFD0FF"
                                                                                    HorizontalAlignment="Center"
                                                                                    VerticalAlignment="Center"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Action}"
                                                                   Foreground="#F3F6FF"
                                                                   FontSize="14"
                                                                   FontWeight="Bold"/>
                                                        <TextBlock Text="{Binding Details}"
                                                                   Foreground="#C3C8D5"
                                                                   FontSize="13"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,3,0,0"/>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding TimestampDisplay}"
                                                               Foreground="#9EA6B8"
                                                               FontSize="11"
                                                               VerticalAlignment="Top"
                                                               Margin="18,3,0,0"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Brak ostatnich akcji"
                                           Foreground="#A2A9BB"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasRecentAuditLogs}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <Grid Background="#990B101B"
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
              Panel.ZIndex="20">
            <Border Background="#171C28"
                    BorderBrush="#343B4D"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="24,18"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <TextBlock Text="Ładowanie dashboardu..."
                           Foreground="#DDE7FF"
                           FontSize="15"
                           FontWeight="SemiBold"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>

<UserControl x:Class="GymAdminPanel.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F6F9">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Dashboard"
                           FontSize="28" FontWeight="Light" Foreground="#2C3E50"/>
                <TextBlock Text="{Binding StatusText}"
                           FontSize="13" Foreground="#7F8C8D" Margin="0,4,0,0"/>
            </StackPanel>

            <Button Grid.Column="1" Content="🔄 Odśwież"
                    Command="{Binding LoadDashboardCommand}"
                    Padding="14,8" Height="36"
                    Background="#2980B9" Foreground="White"
                    FontWeight="SemiBold" BorderThickness="0"
                    Cursor="Hand" FontSize="13"
                    VerticalAlignment="Top"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="#DDE1E7"
                    BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Użytkownicy" Foreground="#7F8C8D" FontSize="13"/>
                    <TextBlock Text="{Binding UsersCount}" Foreground="#2C3E50"
                               FontSize="30" FontWeight="SemiBold" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="White" BorderBrush="#DDE1E7"
                    BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Dzisiejsze zajęcia" Foreground="#7F8C8D" FontSize="13"/>
                    <TextBlock Text="{Binding TodayClassesCount}" Foreground="#2C3E50"
                               FontSize="30" FontWeight="SemiBold" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="White" BorderBrush="#DDE1E7"
                    BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Nieprzeczytane" Foreground="#7F8C8D" FontSize="13"/>
                    <TextBlock Text="{Binding UnreadNotificationsCount}" Foreground="#2C3E50"
                               FontSize="30" FontWeight="SemiBold" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Background="White" BorderBrush="#DDE1E7"
                    BorderThickness="1" CornerRadius="4" Padding="16">
                <StackPanel>
                    <TextBlock Text="Wpisy audytu" Foreground="#7F8C8D" FontSize="13"/>
                    <TextBlock Text="{Binding AuditLogsCount}" Foreground="#2C3E50"
                               FontSize="30" FontWeight="SemiBold" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                  Background="#88FFFFFF" Panel.ZIndex="10">
                <TextBlock Text="⏳ Ładowanie dashboardu..."
                           FontSize="16" Foreground="#2C3E50"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <Border Grid.Column="0" Background="White" BorderBrush="#DDE1E7"
                    BorderThickness="1" CornerRadius="4" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Dzisiejszy harmonogram"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="#2C3E50" Margin="16,14,16,10"/>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding TodayClasses}" Margin="16,0,16,16">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#EDF0F2" BorderThickness="0,0,0,1" Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="74"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding TimeRange}"
                                                   Foreground="#2980B9" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" Foreground="#2C3E50"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding TrainerName}" Foreground="#7F8C8D"
                                                       FontSize="12" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding ParticipantsDisplay}"
                                                   Foreground="#7F8C8D" FontSize="12"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="White" BorderBrush="#DDE1E7"
                    BorderThickness="1" CornerRadius="4" Margin="8,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Ostatnie akcje"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="#2C3E50" Margin="16,14,16,10"/>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding RecentAuditLogs}" Margin="16,0,16,16">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#EDF0F2" BorderThickness="0,0,0,1" Padding="0,10">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Action}"
                                                       Foreground="#2C3E50" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding TimestampDisplay}"
                                                       Foreground="#95A5A6" FontSize="11"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Details}" Foreground="#7F8C8D"
                                                   FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

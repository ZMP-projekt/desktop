<Application x:Class="GymAdminPanel.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GymAdminPanel"
             xmlns:converters="clr-namespace:GymAdminPanel.Converters"
             StartupUri="Views/LoginWindow.xaml">
    <Application.Resources>
        <converters:BoolToVisibilityConverter  x:Key="BoolToVisibilityConverter"/>
        <converters:RoleToColorConverter       x:Key="RoleToColorConverter"/>
        <converters:BoolToRedGreenConverter    x:Key="BoolToRedGreenConverter"/>
        <converters:BoolToTypeColorConverter   x:Key="BoolToTypeColorConverter"/>
        <converters:ActionToColorConverter     x:Key="ActionToColorConverter"/>
        <converters:IntToVisibilityConverter   x:Key="IntToVisibilityConverter"/>
        <converters:StatusKindToBrushConverter x:Key="StatusKindToBrushConverter"/>
    </Application.Resources>
</Application>
